load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@pip//:requirements.bzl", "requirement")

py_library(
    name = "lib",
    srcs = ["main.py"],
    imports = ["."],
    deps = [requirement("requests")],
)

py_binary(
    name = "app",
    srcs = ["main.py"],
    main = "main.py",
    deps = [requirement("requests")],
)

py_test(
    name = "app_test",
    srcs = ["main_test.py"],
    main = "main_test.py",
    deps = [":lib"],
)
